{
  "properties": {
    "displayName": "POL-005 - NSG CIDR Governance",
    "policyType": "Custom",
    "mode": "All",
    "description": "Audits or denies NSG security rules containing overly broad source or destination address prefixes.",
    "metadata": {
      "category": "Network Security",
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Policy enforcement effect."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "broadAddressPrefixes": {
        "type": "Array",
        "metadata": {
          "displayName": "Broad address prefixes",
          "description": "Address prefixes considered overly broad."
        },
        "defaultValue": [
          "*",
          "Any",
          "0.0.0.0/0",
          "::/0",
          "Internet"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/networkSecurityGroups/securityRules"
          },
          {
            "anyOf": [
              {
                "field": "Microsoft.Network/networkSecurityGroups/securityRules/sourceAddressPrefix",
                "in": "[parameters('broadAddressPrefixes')]"
              },
              {
                "field": "Microsoft.Network/networkSecurityGroups/securityRules/destinationAddressPrefix",
                "in": "[parameters('broadAddressPrefixes')]"
              },
              {
                "count": {
                  "field": "Microsoft.Network/networkSecurityGroups/securityRules/sourceAddressPrefixes[*]",
                  "where": {
                    "field": "Microsoft.Network/networkSecurityGroups/securityRules/sourceAddressPrefixes[*]",
                    "in": "[parameters('broadAddressPrefixes')]"
                  }
                },
                "greater": 0
              },
              {
                "count": {
                  "field": "Microsoft.Network/networkSecurityGroups/securityRules/destinationAddressPrefixes[*]",
                  "where": {
                    "field": "Microsoft.Network/networkSecurityGroups/securityRules/destinationAddressPrefixes[*]",
                    "in": "[parameters('broadAddressPrefixes')]"
                  }
                },
                "greater": 0
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}