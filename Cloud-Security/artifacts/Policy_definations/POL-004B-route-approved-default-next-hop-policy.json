{
  "properties": {
    "displayName": "POL-004B - Route Approved Default Next Hop",
    "policyType": "Custom",
    "mode": "All",
    "description": "Audits or denies default routes that do not point to an approved Hub or NVA next-hop IP.",
    "metadata": {
      "category": "Network Security",
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Policy enforcement effect."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "approvedNextHopIPs": {
        "type": "Array",
        "metadata": {
          "displayName": "Approved next-hop IP addresses",
          "description": "Approved Hub or NVA next-hop IP addresses."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/routeTables/routes"
          },
          {
            "field": "Microsoft.Network/routeTables/routes/addressPrefix",
            "equals": "0.0.0.0/0"
          },
          {
            "anyOf": [
              {
                "field": "Microsoft.Network/routeTables/routes/nextHopType",
                "notEquals": "VirtualAppliance"
              },
              {
                "field": "Microsoft.Network/routeTables/routes/nextHopIpAddress",
                "notIn": "[parameters('approvedNextHopIPs')]"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}